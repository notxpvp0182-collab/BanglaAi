<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#030305" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2A0F15"
                android:centerColor="#161219"
                android:endColor="#0D0C10"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.2dp"
                android:color="#5C1922" />
        </shape>
    </item>
</layer-list>
