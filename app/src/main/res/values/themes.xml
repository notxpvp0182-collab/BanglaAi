<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BengaliAgent" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_red_bright</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/accent_red</item>
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Widget.BengaliAgent.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_3d_red</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:elevation">3dp</item>
    </style>

    <style name="Widget.BengaliAgent.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_3d_dark</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.BengaliAgent.Button.Destructive" parent="Widget.BengaliAgent.Button.Primary" />

    <style name="Widget.BengaliAgent.Button.Pill" parent="Widget.BengaliAgent.Button.Secondary">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
