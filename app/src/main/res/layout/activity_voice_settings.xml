<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voice &amp; Speaker Settings"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Configure Bengali &amp; English speech recognition, Text-to-Speech voices, and on-device speaker preference."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Language & TTS Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Conversation Language &amp; TTS Voice"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBengali"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="Bengali (bn-BD)"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:text="English (en-US)"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/cbAutoSpeak"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="Read assistant replies aloud (Text-to-Speech)"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvTtsEngineStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Initializing TTS engine..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerVoices"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnTestTts"
                style="@style/Widget.BengaliAgent.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="Test Active Voice" />
        </LinearLayout>

        <!-- Cloud STT Fallback Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Cloud STT Diagnostic"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Optional fallback for devices without built-in Bengali speech recognition."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTestCloudStt"
                style="@style/Widget.BengaliAgent.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="Test 3-Second Audio Capture" />

            <TextView
                android:id="@+id/tvCloudSttResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Personal Speaker Matching Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. On-Device Speaker Preference"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Security Note: Computes a compact 16-float acoustic embedding locally on-device and immediately zeroes out raw audio. Convenience signal only—never used for device unlock or authentication."
                android:textColor="@color/accent_amber"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbEnableSpeakerMatch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="Warn if a different speaker is detected during sessions"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSpeakerEnrollStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Voice Status: Not Enrolled"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnrollVoice"
                    style="@style/Widget.BengaliAgent.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Enroll My Voice"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTestVoiceMatch"
                    style="@style/Widget.BengaliAgent.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Test Voice Match"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnForgetVoice"
                style="@style/Widget.BengaliAgent.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Forget My Voice" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseVoiceSettings"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:text="Back to Assistant" />

    </LinearLayout>
</ScrollView>
