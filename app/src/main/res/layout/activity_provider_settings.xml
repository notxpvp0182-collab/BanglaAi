<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="মাল্টি-প্রোভাইডার এআই কনফিগারেশন"
            android:textColor="@color/accent_green"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="সতর্কতা: ক্লাউড প্রোভাইডার ব্যবহার করলে আপনার প্রম্পট তাদের সার্ভারে পাঠানো হয় এবং আপনার API কোটা/বিল প্রযোজ্য হতে পারে। সব API Key আপনার ফোনের Android Keystore-এ এনক্রিপ্ট করে রাখা হয়।"
            android:textColor="@color/accent_amber"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbCloudConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:text="আমি ক্লাউড এআই প্রোভাইডারে প্রম্পট পাঠাতে সম্মত"
            android:textColor="@color/text_primary" />

        <!-- Preferred Provider & Failover Order -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="পছন্দের প্রোভাইডার (Preferred Provider):"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerPreferredProvider"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ফেইলওভার ক্রম (কমা দিয়ে লিখুন, যেমন: gemini,groq,openrouter):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etFailoverOrder"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="gemini,groq,openrouter"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveRouting"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/accent_blue"
                android:text="রাউটিং সংরক্ষণ করুন" />
        </LinearLayout>

        <!-- 1. GEMINI SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvGeminiHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="১. Google Gemini API"
                android:textColor="@color/accent_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGeminiKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:hint="AIzaSy... (Gemini API Key)"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbShowGeminiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Key দেখুন"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnDeleteGeminiKey"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Key মুছুন"
                    android:textColor="@color/accent_red" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerGeminiModels"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFetchGeminiModels"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/bg_surface"
                    android:text="মডেল খুঁজুন"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTestGemini"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_green"
                    android:text="Check &amp; Connect"
                    android:textColor="@color/bg_black"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGeminiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="অবস্থা: যাচাই করা হয়নি"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2. GROQ SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvGroqHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="২. Groq Cloud API"
                android:textColor="@color/accent_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGroqKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:hint="gsk_... (Groq API Key)"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbShowGroqKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Key দেখুন"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnDeleteGroqKey"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Key মুছুন"
                    android:textColor="@color/accent_red" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerGroqModels"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFetchGroqModels"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/bg_surface"
                    android:text="মডেল খুঁজুন"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTestGroq"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_green"
                    android:text="Check &amp; Connect"
                    android:textColor="@color/bg_black"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGroqStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="অবস্থা: যাচাই করা হয়নি"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. OPENROUTER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvOpenRouterHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="৩. OpenRouter API"
                android:textColor="@color/accent_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOpenRouterKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:hint="sk-or-v1-... (OpenRouter Key)"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbShowOpenRouterKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Key দেখুন"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnDeleteOpenRouterKey"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Key মুছুন"
                    android:textColor="@color/accent_red" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerOpenRouterModels"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFetchOpenRouterModels"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/bg_surface"
                    android:text="মডেল খুঁজুন"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTestOpenRouter"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent_green"
                    android:text="Check &amp; Connect"
                    android:textColor="@color/bg_black"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOpenRouterStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="অবস্থা: যাচাই করা হয়নি"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/bg_surface"
            android:text="ফিরে যান"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</ScrollView>
