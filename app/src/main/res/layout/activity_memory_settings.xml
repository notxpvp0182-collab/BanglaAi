<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="মেমোরি ও ব্রেইন ব্যবস্থাপনা (Durable Memory)"
        android:textColor="@color/accent_green"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Search & Add Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchMemory"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:hint="মেমোরি খুঁজুন (Search keyword)..."
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSearchMemory"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/accent_blue"
            android:text="খুঁজুন" />

        <Button
            android:id="@+id/btnAddMemory"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/accent_green"
            android:text="+ নতুন"
            android:textColor="@color/bg_black"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Retention & Export Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExportMemory"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="JSON এক্সপোর্ট"
            android:textColor="@color/accent_blue"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnClearAllMemory"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="সব মেমোরি মুছুন"
            android:textColor="@color/accent_red"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCloseMemory"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="ফিরে যান"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMemoryFacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1" />

</LinearLayout>
