<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvOverlayStatusDot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="● এআই সক্রিয়"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnOverlayMute"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="42dp"
        android:layout_height="32dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="2dp"
        android:text="🎤"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnOverlayPause"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="2dp"
        android:text="বিরতি"
        android:textColor="@color/accent_amber"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btnOverlayStop"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="2dp"
        android:text="থামুন"
        android:textColor="@color/accent_red"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnOverlayDisable"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="36dp"
        android:layout_height="32dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="2dp"
        android:text="✕"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
