<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sumu_anime_companion"
    android:padding="16dp">

    <!-- ========================================================= -->
    <!-- 1. MINIMAL PREMIUM HOME SCREEN (IDLE STATE)               -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/layoutHomeIdle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Top Minimal Identity & Settings Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAgentState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Idle"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnOpenSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_control_idle"
                android:contentDescription="Open AI &amp; Model Settings"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings_gear" />
        </LinearLayout>

        <!-- Selected Provider & Active Voice Model Pill -->
        <TextView
            android:id="@+id/tvSelectedProviderModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="16dp"
            android:paddingVertical="7dp"
            android:text="Google Gemini • Auto Live Model"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Center Ambient AI Orb -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/flHomeOrbContainer"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/viewHomeOrbOuter"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ai_orb_outer" />

                <View
                    android:id="@+id/viewHomeOrbCore"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ai_orb_core" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvHomeConnectionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Ready for real-time voice conversation in Bengali &amp; English"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Prominent Call AI Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnStartAiCall"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_circle_call_start"
                android:contentDescription="Call AI"
                android:elevation="8dp"
                android:padding="22dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call_phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Call Sumu"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- 2. CALLING / CONNECTING TRANSITION SCREEN                 -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/layoutCallingTransition"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallingStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calling..."
            android:textColor="@color/accent_cyan"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCallingModelInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Establishing encrypted real-time audio session"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:id="@+id/viewCallingPulseRing"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ai_orb_outer" />

            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ai_orb_core" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnCancelCalling"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_circle_call_end"
            android:contentDescription="Cancel Call"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_call_end" />
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- 3. FULL-SCREEN ACTIVE CALL INTERFACE                      -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/layoutActiveCall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Active Call Bar: Identity, Duration Timer, Connection Quality -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveCallQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="HD 24kHz PCM • Live"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCallDurationTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Screen Share Live Pill Indicator (Visible when sharing) -->
        <TextView
            android:id="@+id/tvInCallScreenShareBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="● Screen Sharing Active — AI can see your screen"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Center Large Audio-Reactive AI Orb -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:id="@+id/viewActiveOrbOuter"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ai_orb_outer" />

            <View
                android:id="@+id/viewActiveOrbCore"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ai_orb_core" />
        </FrameLayout>

        <!-- Minimal Call State Label (Listening / Thinking / Speaking) -->
        <TextView
            android:id="@+id/tvActiveCallState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Listening..."
            android:textColor="@color/accent_cyan"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 4 Circular Bottom Call Controls: Mute, Screen Share, Speaker, End Call -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="16dp"
            android:weightSum="4">

            <!-- 1. Microphone Mute / Unmute -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMicToggle"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_circle_control_idle"
                    android:contentDescription="Mute or Unmute Microphone"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic_on" />

                <TextView
                    android:id="@+id/tvMicToggleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mute"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 2. In-Call Screen Share -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnScreenToggle"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_circle_control_idle"
                    android:contentDescription="Toggle Screen Share"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_screen_share" />

                <TextView
                    android:id="@+id/tvScreenToggleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Screen"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3. Speakerphone On / Off -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSpeakerToggle"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_circle_control_active"
                    android:contentDescription="Toggle Speakerphone"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_speaker_phone" />

                <TextView
                    android:id="@+id/tvSpeakerToggleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Speaker"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 4. End Call -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnStopTask"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_circle_call_end"
                    android:contentDescription="End Call"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="End Call"
                    android:textColor="@color/accent_red_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
