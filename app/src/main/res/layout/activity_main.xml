<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Premium Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAgentState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ready"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrivacyIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Mic Off | Screen Off"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnOpenSettings"
            style="@style/Widget.BengaliAgent.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="AI Connection"
            android:textColor="@color/accent_cyan" />
    </LinearLayout>

    <!-- Quick Action Pills Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleAssistant"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/accent_primary"
                android:text="Enable Assistant"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPauseResume"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="Pause" />

            <Button
                android:id="@+id/btnStopTask"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/accent_red"
                android:text="Stop"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnScreenToggle"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="Screen View: Off" />

            <Button
                android:id="@+id/btnMemoryBrain"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="Memory" />

            <Button
                android:id="@+id/btnVoiceSettings"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="Voice Settings" />

            <Button
                android:id="@+id/btnMediaStudio"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="Video Studio" />

            <Button
                android:id="@+id/btnCodingStudio"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="Coding Studio" />

            <Button
                android:id="@+id/btnSetupWizard"
                style="@style/Widget.BengaliAgent.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Permissions" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Conversation Transcript Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:contentDescription="Conversation transcript"
        android:padding="10dp" />

    <!-- Refined Message Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnMicToggle"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Toggle microphone"
            android:text="Mic"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etUserInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Ask in English or Bengali..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            style="@style/Widget.BengaliAgent.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Send message"
            android:text="Send" />
    </LinearLayout>

</LinearLayout>
