<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Dark & Red 3D Header with Corner Settings Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAgentState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ready"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrivacyIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Mic Off | Screen Off"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Single Corner Settings Gear Button -->
        <Button
            android:id="@+id/btnOpenSettings"
            style="@style/Widget.BengaliAgent.Button.Primary"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:contentDescription="Open Settings"
            android:padding="0dp"
            android:text="⚙"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Clean 4-Button 3D Session Control Row (No Clutter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/btnToggleAssistant"
            style="@style/Widget.BengaliAgent.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Start"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPauseResume"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Pause"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStopTask"
            style="@style/Widget.BengaliAgent.Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Stop"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnScreenToggle"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Screen: Off"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Conversation Transcript Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:contentDescription="Conversation transcript"
        android:padding="12dp" />

    <!-- Bottom 3D Message Composer (Fixed Wide Mic Button) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnMicToggle"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Toggle microphone"
            android:paddingHorizontal="6dp"
            android:singleLine="true"
            android:text="🎤 Mic"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etUserInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Ask in English or Bengali..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            style="@style/Widget.BengaliAgent.Button.Primary"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send message"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:text="Send"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
