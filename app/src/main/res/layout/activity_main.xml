<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Compact Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAgentState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Ready"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrivacyIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Mic Muted | Screen Off"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Sleek Vector Gear Icon Button in Corner -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_3d_red"
            android:contentDescription="Open Settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_gear" />
    </LinearLayout>

    <!-- Compact 38dp Session Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/btnToggleAssistant"
            style="@style/Widget.BengaliAgent.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Start"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPauseResume"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Pause"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnStopTask"
            style="@style/Widget.BengaliAgent.Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Stop"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnScreenToggle"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="Screen: Off"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Conversation Transcript Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:contentDescription="Conversation transcript"
        android:padding="10dp" />

    <!-- Bottom Message Composer with Vector Mic Toggle Icon (No Emoji) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnMicToggle"
            style="@style/Widget.BengaliAgent.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Toggle microphone mute or unmute"
            android:drawableStart="@drawable/ic_mic_off"
            android:drawablePadding="6dp"
            android:minWidth="78dp"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:text="Muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etUserInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Ask in English or Bengali..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="40dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSend"
            style="@style/Widget.BengaliAgent.Button.Primary"
            android:layout_width="68dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Send message"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:text="Send"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
